+  console.error(`[metaCampaignCreate] POST ${path} falló. Respuesta completa de Meta:`, JSON.stringify(data, null, 2));
+  return { _error: { status: res.status, message: detailedMessage || `HTTP ${res.status}`, body: data } };
+}
